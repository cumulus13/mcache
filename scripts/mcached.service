# /etc/systemd/system/mcached.service  (Linux: TCP/RESP transport only; MSMQ is Windows-only)
[Unit]
Description=mcached - Redis-compatible cache server
After=network.target

[Service]
Type=simple
User=mcached
Group=mcached
ExecStart=/opt/mcached/server/mcached --config /etc/mcached/config.json
Restart=on-failure
RestartSec=2
LimitNOFILE=65535
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/mcached /etc/mcached

[Install]
WantedBy=multi-user.target
